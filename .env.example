# ── Gateway (AI hook scoring) ──────────────────────────────────
GATEWAY_URL=http://127.0.0.1:8000
GATEWAY_MODEL=claude-sonnet-4-5

# ── Whisper (GPU transcription) ────────────────────────────────
WHISPER_MODEL=base.en           # base.en | small.en | medium.en | large-v3
WHISPER_DEVICE=auto             # auto | cuda | cpu
WHISPER_COMPUTE=int8            # int8 | float16 | float32

# ── Clip selection ─────────────────────────────────────────────
NUM_CLIPS=6
MIN_CLIP_S=15
MAX_CLIP_S=60

# ── Output encoding ────────────────────────────────────────────
USE_NVENC=1                     # 1 = GPU encode (RTX), 0 = CPU (libx264)
TARGET_W=1080
TARGET_H=1920

# ── Captions ──────────────────────────────────────────────────
CAPTION_STYLE=karaoke           # karaoke | boxed | bold
ACCENT_HEX=#FF5C38
FONT_NAME=Arial
FONT_SIZE=120

# ── B-roll (optional) ─────────────────────────────────────────
PEXELS_API_KEY=
BROLL=0
